# -----------------------------------------------------------------------------
# Secrets, credentials, and local environment (never commit these)
# -----------------------------------------------------------------------------
.env
.env.*
.envrc
.python-env
*.secret
secrets/
credentials/
*credentials*.json
service-account*.json
*.pem
id_rsa
id_rsa.pub
*.p12
.netrc
netrc

# Raw author photos (only the stripped manuscript/frank.jpg is tracked)
*.heic
*.HEIC
*_original.*
*_original
*.orig.jpg
*.orig.jpeg
*.orig.png

# Optional local overrides that may contain tokens or paths
config/local_config.yaml
config/*local*.yaml
*.override.yaml

# Hugging Face / ML tooling (if stored inside the repo tree)
.huggingface/

# -----------------------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Editors
.idea/
.vscode/
*.swp

# macOS
.DS_Store
* 2.*

# Logs / experiment artifacts
wandb/
*.log
/logs/

# LaTeX build artifacts
*.aux
*.out
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
# *.log already ignored above under Logs

# Local caches
.cache/

# Experiment results: track run JSON/YAML under results/raw/ for reproducibility.
# Ignore heavy weight artifacts and checkpoint directories.
*.pt
*.bin
*.safetensors
results/**/*.pth
results/**/checkpoint*/

# Local exports: handoffs, Stage 0 summaries, Claude bundles (do not commit)
exports/**
!exports/.gitkeep
**/*handoff*.txt
**/*handoff*.md

# Stage 5 brief and stage-specific docs can be kept local-only.
docs/stage5.md
docs/stage1_pathB.md
docs/stage4_setup.md

# Local maintainer drafting copies; do not track
docs/drafts/

# Figures: keep generated plots (usually small); ignore huge raw exports if needed
figures/**/*.tif
figures/**/*.psd
dist/

# --- fedlora-partition-variance additions ---
*.safetensors
checkpoints/
.venv/
wandb/

# Intermediate review packages and root manuscript snapshots (use manuscript/main.pdf)
phase_*_review*/
phase_*_review*.zip
manuscript_review_*/
manuscript_review_*.zip
manuscript_review_*.pdf
manuscript_o*_*.pdf
*.bak
analysis/*_scratch_*.csv
analysis/*.csv.bak

# Local O11 Linux runner tooling
.o11_linux/
.tmp_o10/

# Local N6/N8/N9 ops leftovers (not selected by build_runs_table / verify)
results/quarantine_duplicate_complete/
results/m1_timing_sync/
results/m2_timing_sync/
results/launch/*_n8_*.jsonl
results/raw/**/n6_scratch_*/
# Pre-retrain stackdrift raw dirs and stale holdout mirrors left on disk after
